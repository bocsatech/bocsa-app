#!/bin/bash
set -euo pipefail
# Használat bárhonnan: wh-agent start | login | sync | stop | telepites
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

CMD="${1:-start}"
shift || true

wh_cd

case "$CMD" in
  start|inditas)
    wh_auto_update || true
    echo "Willhaben Agent — http://127.0.0.1:3860"
    exec caffeinate -dims npm start
    ;;
  login|bejelentkezes)
    wh_auto_update || true
    exec npm run login
    ;;
  sync|szinkron)
    wh_auto_update || true
    exec npm run sync
    ;;
  sync-debug|debug)
    wh_auto_update || true
    exec npm run sync:debug
    ;;
  stop|leallitas)
    exec npm run stop
    ;;
  telepites|install|update|frissites)
    exec bash "${SCRIPT_DIR}/../install-mac.command"
    ;;
  *)
    echo "wh-agent: start | login | sync | sync-debug | stop | telepites"
    exit 1
    ;;
esac
