# BOCSA Pro szerver (SSH)
# Másold config.env névre és töltsd ki.

# Szerver címe (ahol a teljes BOCSA Pro fut)
BOCSA_SERVER_HOST=example.com
BOCSA_SSH_USER=bocsa

# A szerveren futó orchestrator portja
BOCSA_REMOTE_PORT=3850

# Helyi tunell port (böngésző ezt nyitja)
BOCSA_LOCAL_PORT=3850

# SSH kulcs (opcionális, üres = alapértelmezett)
# BOCSA_SSH_KEY=~/.ssh/id_ed25519
